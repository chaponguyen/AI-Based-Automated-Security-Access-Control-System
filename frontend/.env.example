# Địa chỉ gốc của backend FastAPI (không thêm /api).
VITE_API_URL=http://localhost:8000

# 1 để mô phỏng POST /api/residents khi backend đăng ký chưa sẵn sàng; 0 để gọi backend thật.
VITE_MOCK_REGISTER=0

# Số giây chuẩn bị căn mặt trước khi frontend gửi POST /api/residents.
VITE_REGISTER_PREPARE_SECONDS=5

# 1 để hiện nút mô phỏng các sự kiện dashboard; 0 để ẩn nút này.
VITE_MOCK_EVENTS=0

# 1 để mô phỏng chức năng quản trị chưa có ở backend B15/B16; 0 để gọi API thật.
VITE_MOCK_ADMIN=0
