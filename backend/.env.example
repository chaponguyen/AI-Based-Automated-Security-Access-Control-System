DATABASE_URL=postgresql://postgres:matkhau@localhost:5432/access_control
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
# Cấu hình Camera (B11)
# CAMERA_SOURCE=local (webcam máy tính) hoặc http://<ip>:81/stream (ESP32-CAM giai đoạn 3)
CAMERA_SOURCE=local
CAMERA_INDEX=0
CAMERA_W=1280
CAMERA_H=720
AI_FPS=6
AI_FPS_IDLE=3
STREAM_MAX_FPS=12
STREAM_WIDTH=960
STREAM_JPEG_QUALITY=70
SPEAK_ENABLED=true
SPEAK_ENGINE=edge
SPEAK_VOICE_ID=vi-VN-NamMinhNeural
SPEAK_RATE=170
SPEAK_VOLUME=1.0
ALERT_REPEAT=2
DEDUP_SECONDS=5
ROOM_READ_MODE=floor_room

# Cấu hình chống báo lặp xác thực nền B12 (CP-04)
# GRANTED_COOLDOWN_S: Thời gian chờ trước khi báo lại cư dân đã được cấp quyền (giây)
GRANTED_COOLDOWN_S=60
# STRANGER_REST_S: Thời gian nghỉ sau khi cảnh báo người lạ (giây)
STRANGER_REST_S=15

# Cấu hình chống đăng ký trùng khuôn mặt (B5 CP-07)
# DUPLICATE_SIM_THRESHOLD: Ngưỡng tương đồng cosine để xác định cư dân đã tồn tại
DUPLICATE_SIM_THRESHOLD=0.50

# Cấu hình hiển thị nhãn stream (B13 CP-03)
# DEBUG_OVERLAY: 1 = hiện thêm độ giống similarity ở cuối nhãn (ví dụ "Khuê 0,58"), 0 = tắt
DEBUG_OVERLAY=0

# Cấu hình xác thực và phiên B15 (CP-02, CP-03)
# SESSION_HOURS: Thời gian hiệu lực phiên đăng nhập (mặc định 8 giờ)
SESSION_HOURS=8
# LOGIN_MAX_FAILS: Số lần đăng nhập sai tối đa trước khi khóa tài khoản
LOGIN_MAX_FAILS=5
# LOGIN_LOCK_MINUTES: Thời gian khóa tài khoản tạm thời khi vượt số lần sai (phút)
LOGIN_LOCK_MINUTES=5
# COOKIE_SECURE: 0 = cho phép HTTP dev (SameSite=Lax, Secure=False); 1 = yêu cầu HTTPS production
COOKIE_SECURE=0

# Cấu hình dịch vụ cửa mô phỏng B16 (CP-05)
# DOOR_OPEN_SECONDS: Thời gian mở cửa tự động trước khi đóng lại (giây)
DOOR_OPEN_SECONDS=10


